# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워넣으세요.
#   cp .env.example .env
# .env는 git에 커밋하지 마세요 (.gitignore에 추가 권장).

# ── 도메인 / SSL ─────────────────────────────
# 가비아에서 구매한 도메인 (예: helf-app.com)
DOMAIN=your-domain.com
# Let's Encrypt 인증서 만료 알림을 받을 이메일
CERTBOT_EMAIL=you@example.com

# ── MySQL ────────────────────────────────────
DB_NAME=helf
DB_USERNAME=helf_user
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# ── Spring ───────────────────────────────────
# 최초 배포/스키마 변경 시 update, 안정화 후에는 validate 권장
DDL_AUTO=update
# Swagger UI(/swagger-ui.html)를 외부에 노출할지 여부. 운영 단계에서 막고 싶으면 false로 변경
SWAGGER_ENABLED=true
